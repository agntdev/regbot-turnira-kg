[
  {
    "name": "Регистрация не принимает перенос строки в названии",
    "steps": [
      {
        "send": { "callback": "registration:start" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите название команды." } }]
      },
      {
        "send": { "text": "Bishkek\nWolves" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Название должно содержать от 2 до 40 символов. Попробуйте ещё раз." } }]
      }
    ]
  },
  {
    "name": "Регистрация команды с минимальными данными",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Введите название команды."
            }
          }
        ],
        "send": {
          "callback": "registration:start"
        }
      }
      ,
      {
        "send": { "text": "Bishkek Wolves" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите игровой ID капитана." } }]
      },
      {
        "send": { "text": "captain-1" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите никнейм капитана." } }]
      },
      {
        "send": { "text": "Aibek" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите Telegram @username капитана или отправьте «-»." } }]
      },
      {
        "send": { "text": "-" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите телефон капитана или отправьте «-»." } }]
      },
      {
        "send": { "text": "-" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите игровой ID первого игрока." } }]
      },
      {
        "send": { "text": "player-1" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Введите никнейм игрока." } }]
      },
      {
        "send": { "text": "Bek" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Добавьте следующего игрока или завершите список." } }]
      },
      {
        "send": { "callback": "registration:preview" },
        "expect": [{ "method": "editMessageText", "payload": { "text": "Проверьте заявку:\nКоманда: Bishkek Wolves\nКапитан: Aibek (captain-1)\nИгроков: 1" } }]
      },
      {
        "send": { "callback": "registration:confirm" },
        "expect": [{ "method": "editMessageText", "payload": { "text": "Заявка отправлена организаторам. Уведомления организаторов пока не настроены." } }]
      }
    ]
  }
]
